# Copy this file to `.env` (gitignored) and fill in your Supabase project
# values. Find them at: Supabase dashboard → Project Settings → API.
#
# The anon key is a PUBLIC key — safe in the browser because Row Level
# Security protects every table. NEVER put the service-role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
